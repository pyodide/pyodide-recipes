From 7a31acb66471049c91fa2a92675aa3adecf5378b Mon Sep 17 00:00:00 2001
From: Steven Weaver <sweaver@temple.edu>
Date: Fri, 13 Nov 2026 14:16:30 +0900
Subject: [PATCH] use emmake

---
 setup.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/setup.py b/setup.py
index bc55517..e6b2add 100644
--- a/setup.py
+++ b/setup.py
@@ -75,11 +75,11 @@ def run_configure(option):
 
 def run_make(targets):
     sys.stdout.flush()
-    subprocess.check_call([os.environ.get("MAKE", "make")] + targets)
+    subprocess.check_call(["emmake", os.environ.get("MAKE", "make")] + targets)
 
 
 def run_make_print_config():
-    stdout = subprocess.check_output([os.environ.get("MAKE", "make"), "-s", "print-config"], encoding="ascii")
+    stdout = subprocess.check_output(["emmake", os.environ.get("MAKE", "make"), "-s", "print-config"], encoding="ascii")
 
     make_print_config = {}
     for line in stdout.splitlines():
-- 
